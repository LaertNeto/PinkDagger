{
  "manifest_version": 3,
  "name": "PinkDagger for Roll20",
  "version": "0.4.1",
  "description": "Interface customizada e interativa para fichas de Daggerheart no Roll20.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pinkdagger@laertneto",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.roll20.net/editor*",
        "https://app.roll20.net/editor/*"
      ],
      "js": [
        "src/constants.js",
        "src/utils.js",
        "src/npcParser.js",
        "src/roll20.js",
        "src/modals.js",
        "src/sheet.js",
        "src/companion.js",
        "src/dock.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css"
      ],
      "matches": [
        "https://app.roll20.net/*"
      ]
    }
  ]
}